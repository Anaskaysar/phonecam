{
  "name": "phonecam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-pages.mjs && node scripts/build-extension.mjs",
    "build:pages": "vite build --base /phonecam/ && node scripts/build-pages.mjs && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:all": "npm test && npm run test:e2e",
    "pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "playwright": "^1.63.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^3"
  }
}
