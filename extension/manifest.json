{
  "manifest_version": 3,
  "name": "PhoneCam",
  "version": "1.0.0",
  "description": "Use your phone as a camera in Google Meet, Teams, Zoom and other browser meetings. Nothing to install on the phone.",
  "homepage_url": "https://phonecam.app",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PhoneCam",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://whereby.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*",
        "https://*.webex.com/*",
        "https://phonecam.app/*",
        "https://www.phonecam.app/*"
      ],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://discord.com/*",
        "https://whereby.com/*",
        "https://*.whereby.com/*",
        "https://meet.jit.si/*",
        "https://*.webex.com/*",
        "https://phonecam.app/*",
        "https://www.phonecam.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
